
# Stage 1: Build the React frontend
FROM node:22-alpine AS frontend-build

WORKDIR /frontend

COPY frontend/package*.json ./
RUN npm install

COPY frontend/ ./
RUN npm run build


# Stage 2: Build the Spring Boot backend
FROM maven:3.9-eclipse-temurin-21 AS backend-build

WORKDIR /app

COPY backend/pom.xml ./
COPY backend/src ./src

# Serve the React production build through Spring Boot
COPY --from=frontend-build /frontend/dist/ ./src/main/resources/static/

RUN mvn -B -DskipTests package


# Stage 3: Run the complete application
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

COPY --from=backend-build /app/target/payease-backend-1.0.0.jar app.jar

ENV PORT=80

EXPOSE 80

ENTRYPOINT ["sh", "-c", "java -Dserver.port=${PORT:-80} -jar /app/app.jar"]
